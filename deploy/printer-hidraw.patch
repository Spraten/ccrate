 /// HID report size for the Supvan T50 Pro USB interface.
 pub const HID_REPORT_SIZE: usize = 64;
 
+/// Linux hidraw expects the report ID in byte 0 even for unnumbered reports.
+/// The device's 64-byte payload therefore needs a separate leading zero byte.
+const HID_REPORT_BUFFER_SIZE: usize = HID_REPORT_SIZE + 1;
+
+fn encode_output_report(data: &[u8]) -> [u8; HID_REPORT_BUFFER_SIZE] {
+    let mut report = [0u8; HID_REPORT_BUFFER_SIZE];
+    let copy_len = data.len().min(HID_REPORT_SIZE);
+    report[1..1 + copy_len].copy_from_slice(&data[..copy_len]);
+    report
+}
+
+fn ensure_full_write(actual: usize, expected: usize) -> Result<()> {
+    if actual == expected {
+        Ok(())
+    } else {
+        Err(Error::Io(std::io::Error::new(
+            std::io::ErrorKind::WriteZero,
+            format!("short hidraw write: {actual} of {expected} bytes"),
+        )))
+    }
+}
