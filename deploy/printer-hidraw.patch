+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn output_report_keeps_zero_leading_payload_after_report_id() {
+        let payload: [u8; HID_REPORT_SIZE] = std::array::from_fn(|i| i as u8);
+        let report = encode_output_report(&payload);
+
+        assert_eq!(report[0], 0, "unnumbered HID report ID");
+        assert_eq!(&report[1..], &payload);
+    }
+
+    #[test]
+    fn output_report_preserves_nonzero_leading_payload() {
+        let mut payload = [0u8; HID_REPORT_SIZE];
+        payload[0] = 0xc0;
+        let report = encode_output_report(&payload);
+
+        assert_eq!(report[0], 0, "unnumbered HID report ID");
+        assert_eq!(&report[1..], &payload);
+    }
+
+    #[test]
+    fn output_report_is_padded_and_reports_short_write() {
+        let report = encode_output_report(&[0xc0, 0x40]);
+
+        assert_eq!(report[0], 0);
+        assert_eq!(&report[1..3], &[0xc0, 0x40]);
+        assert!(report[3..].iter().all(|byte| *byte == 0));
+        assert!(ensure_full_write(HID_REPORT_SIZE, HID_REPORT_SIZE + 1).is_err());
+    }
+}
