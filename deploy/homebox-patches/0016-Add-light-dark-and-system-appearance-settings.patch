diff --git a/frontend/lib/data/theme-preference.test.ts b/frontend/lib/data/theme-preference.test.ts
new file mode 100644
index 00000000..4f1b152a
--- /dev/null
+++ b/frontend/lib/data/theme-preference.test.ts
@@ -0,0 +1,29 @@
+import { describe, expect, it } from "vitest";
+import { resolveTheme } from "./theme-preference";
+
+describe("resolveTheme", () => {
+  it("follows the OS when the Homebox default has no saved mode", () => {
+    expect(resolveTheme("homebox", null, false)).toBe("homebox");
+    expect(resolveTheme("homebox", null, true)).toBe("night");
+  });
+
+  it("uses an explicit light or dark mode", () => {
+    expect(resolveTheme("homebox", "light", true)).toBe("light");
+    expect(resolveTheme("homebox", "dark", false)).toBe("night");
+  });
+
+  it("preserves existing custom theme choices across system preference", () => {
+    expect(resolveTheme("forest", "system", false)).toBe("forest");
+    expect(resolveTheme("dracula", null, false)).toBe("dracula");
+  });
+
+  it("preserves legacy explicit base themes until a mode is selected", () => {
+    expect(resolveTheme("light", null, true)).toBe("light");
+    expect(resolveTheme("dark", null, false)).toBe("night");
+  });
+
+  it("uses OS preference when system mode is explicitly selected", () => {
+    expect(resolveTheme("homebox", "system", false)).toBe("homebox");
+    expect(resolveTheme("homebox", "system", true)).toBe("night");
+  });
+});
diff --git a/frontend/lib/data/theme-preference.ts b/frontend/lib/data/theme-preference.ts
new file mode 100644
index 00000000..dcf5bc8b
--- /dev/null
+++ b/frontend/lib/data/theme-preference.ts
@@ -0,0 +1,26 @@
+import type { DaisyTheme } from "./themes";
+
+export type ThemeMode = "light" | "dark" | "system";
+
+/** Resolve the selected palette, preserving saved custom and legacy themes. */
+export function resolveTheme(theme: DaisyTheme, mode: ThemeMode | null, prefersDark: boolean): DaisyTheme {
+  if (theme !== "homebox" && theme !== "light" && theme !== "dark") {
+    return theme;
+  }
+
+  if (mode === "light") {
+    return "light";
+  }
+
+  if (mode === "dark") {
+    return "night";
+  }
+
+  // Older preferences stored only a theme. Keep an explicit light/dark choice
+  // until the user chooses a mode in the new controls.
+  if (mode === null && (theme === "light" || theme === "dark")) {
+    return theme === "dark" ? "night" : "light";
+  }
+
+  return prefersDark ? "night" : "homebox";
+}
