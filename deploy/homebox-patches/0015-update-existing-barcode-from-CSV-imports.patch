+func TestCSVImportUpdatesExistingBarcodeOnlyWhenColumnIsPresent(t *testing.T) {
+	tests := []struct {
+		name        string
+		include     bool
+		value       string
+		wantBarcode string
+	}{
+		{name: "replaces barcode", include: true, value: "0009876", wantBarcode: "0009876"},
+		{name: "clears barcode with blank value", include: true, value: "", wantBarcode: ""},
+		{name: "older CSV preserves barcode", include: false, wantBarcode: "0012345"},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			ctx := context.Background()
+			g, err := tRepos.Groups.GroupCreate(ctx, "csv-existing-barcode-"+fk.Str(4), uuid.Nil)
+			require.NoError(t, err)
+			locationType, err := tRepos.EntityTypes.GetDefault(ctx, g.ID, true)
+			require.NoError(t, err)
+			itemType, err := tRepos.EntityTypes.GetDefault(ctx, g.ID, false)
+			require.NoError(t, err)
+			location, err := tRepos.Entities.Create(ctx, g.ID, repo.EntityCreate{
+				Name:         "Barcode Import Location",
+				EntityTypeID: locationType.ID,
+			})
+			require.NoError(t, err)
+			ref := "existing-barcode-ref-" + fk.Str(4)
+			_, err = tRepos.Entities.Create(ctx, g.ID, repo.EntityCreate{
+				ImportRef:    ref,
+				Name:         "Existing barcode item",
+				ParentID:     location.ID,
+				EntityTypeID: itemType.ID,
+				Barcode:      "0012345",
+			})
+			require.NoError(t, err)
+
+			header := "HB.import_ref,HB.location,HB.name"
+			row := ref + ",Barcode Import Location,Existing barcode item"
+			if tc.include {
+				header += ",HB.barcode"
+				row += "," + tc.value
+			}
+			imported, err := tSvc.Entities.CsvImport(ctx, g.ID, strings.NewReader(header+"\n"+row+"\n"))
+			require.NoError(t, err)
+			require.Equal(t, 1, imported)
+			updated, err := tRepos.Entities.GetByRef(ctx, g.ID, ref)
+			require.NoError(t, err)
+			assert.Equal(t, tc.wantBarcode, updated.Barcode)
+		})
+	}
+}
