+      }
+      if (!duplicateResult.error) {
+        duplicateItems.value = append
+          ? appendDuplicatePage(duplicateItems.value, duplicateResult.items)
+          : duplicateResult.items;
+        duplicateTotal.value = duplicateResult.total;
+        duplicatePage.value = duplicateResult.page;
+      } else if (productLookup.status === "found") {
+        barcodeLookupMessage.value = t("components.entity.create_modal.barcode_lookup.error");
+      }
+      barcodeSearching.value = false;
+    });
+    if (!applied) return;
   }
 
