+          fileBase64: product.imageBase64,
+          primary: true,
+          file: dataURLtoFile(product.imageBase64, "product_view.jpg"),
+        },
+      ]);
+    }
+  }
+
+  function loadMoreDuplicates() {
+    if (duplicatePage.value < duplicatePageCount(duplicateTotal.value, duplicatePageSize)) {
+      void lookupBarcode(duplicatePage.value + 1, true);
+    }
   }
 
   function openDuplicate(id: string) {
-    closeDialog(DialogID.CreateEntity);
-    navigateTo(`/item/${id}`);
+    openBarcodeDuplicate(id, () => closeDialog(DialogID.CreateEntity), navigateTo);
