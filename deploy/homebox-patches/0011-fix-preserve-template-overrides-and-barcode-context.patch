diff --git a/backend/app/api/handlers/v1/v1_ctrl_entity_templates_test.go b/backend/app/api/handlers/v1/v1_ctrl_entity_templates_test.go
new file mode 100644
index 00000000..7da47bb7
--- /dev/null
+++ b/backend/app/api/handlers/v1/v1_ctrl_entity_templates_test.go
@@ -0,0 +1,49 @@
+package v1
+
+import (
+	"fmt"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"github.com/sysadminsmedia/homebox/backend/internal/web/adapters"
+)
+
+func TestDecodeTemplateItemTrimsBarcodeBeforeLengthValidation(t *testing.T) {
+	barcode := strings.Repeat("x", 80)
+	body := fmt.Sprintf(`{"name":"Test item","parentId":"00000000-0000-4000-8000-000000000001","barcode":" %s "}`, barcode)
+	request := httptest.NewRequest("POST", "/", strings.NewReader(body))
+
+	decoded, err := adapters.DecodeBody[EntityTemplateCreateItemRequest](request)
+	require.NoError(t, err)
+	require.Equal(t, barcode, decoded.Barcode)
+}
+
+func TestTemplateItemMetadataUsesDefaultsWhenOmittedAndAllowsExplicitClearing(t *testing.T) {
+	t.Run("omitted fields retain defaults", func(t *testing.T) {
+		request := decodeTemplateItemRequest(t, `{"name":"Test item","parentId":"00000000-0000-4000-8000-000000000001"}`)
+		require.Nil(t, request.Manufacturer)
+		require.Nil(t, request.ModelNumber)
+		manufacturer, modelNumber := resolveTemplateItemMetadata("Maker default", "Model default", request)
+		require.Equal(t, "Maker default", manufacturer)
+		require.Equal(t, "Model default", modelNumber)
+	})
+
+	t.Run("explicit empty fields clear defaults", func(t *testing.T) {
+		request := decodeTemplateItemRequest(t, `{"name":"Test item","parentId":"00000000-0000-4000-8000-000000000001","manufacturer":"","modelNumber":""}`)
+		require.NotNil(t, request.Manufacturer)
+		require.NotNil(t, request.ModelNumber)
+		manufacturer, modelNumber := resolveTemplateItemMetadata("Maker default", "Model default", request)
+		require.Empty(t, manufacturer)
+		require.Empty(t, modelNumber)
+	})
+}
+
+func decodeTemplateItemRequest(t *testing.T, body string) EntityTemplateCreateItemRequest {
+	t.Helper()
+	request := httptest.NewRequest("POST", "/", strings.NewReader(body))
+	decoded, err := adapters.DecodeBody[EntityTemplateCreateItemRequest](request)
+	require.NoError(t, err)
+	return decoded
+}
