index 00000000..e01c3160
--- /dev/null
+++ b/frontend/composables/use-location-helpers.test.ts
@@ -0,0 +1,61 @@
+import { describe, expect, test } from "vitest";
+import type { TreeItem } from "~~/lib/api/types/data-contracts";
+import { flatTree, getVisibleLocations } from "./use-location-helpers";
+
+describe("flatTree", () => {
+  test("keeps parent and depth metadata for expandable location navigation", () => {
+    const tree: TreeItem[] = [
+      {
+        id: "home",
+        name: "Home",
+        type: "location",
+        children: [
+          { id: "office", name: "Office", type: "location", children: [] },
+          {
+            id: "garage",
+            name: "Garage",
+            type: "location",
+            children: [
+              { id: "office-2", name: "Office", type: "location", children: [] },
+              { id: "shelf", name: "Shelf", type: "location", children: [] },
+            ],
+          },
+        ],
+      },
+    ];
+
+    expect(flatTree(tree)).toEqual([
+      { id: "home", name: "Home", treeString: "Home", parentId: null, depth: 0, hasChildren: true },
+      { id: "office", name: "Office", treeString: "Home > Office", parentId: "home", depth: 1, hasChildren: false },
+      { id: "garage", name: "Garage", treeString: "Home > Garage", parentId: "home", depth: 1, hasChildren: true },
+      { id: "office-2", name: "Office", treeString: "Home > Garage > Office", parentId: "garage", depth: 2, hasChildren: false },
+      { id: "shelf", name: "Shelf", treeString: "Home > Garage > Shelf", parentId: "garage", depth: 2, hasChildren: false },
+    ]);
+  });
+
+  test("shows descendants only while their parent locations are expanded", () => {
+    const locations = flatTree([
+      {
+        id: "home",
+        name: "Home",
+        type: "location",
+        children: [
+          {
+            id: "garage",
+            name: "Garage",
+            type: "location",
+            children: [{ id: "shelf", name: "Shelf", type: "location", children: [] }],
+          },
+        ],
+      },
+    ]);
+
+    expect(getVisibleLocations(locations, new Set()).map(location => location.id)).toEqual(["home"]);
+    expect(getVisibleLocations(locations, new Set(["home"])).map(location => location.id)).toEqual(["home", "garage"]);
+    expect(getVisibleLocations(locations, new Set(["home", "garage"])).map(location => location.id)).toEqual([
+      "home",
+      "garage",
+      "shelf",
+    ]);
+  });
+});
