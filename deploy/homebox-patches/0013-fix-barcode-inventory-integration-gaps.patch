+func TestEntityRepository_DuplicateCopiesBarcode(t *testing.T) {
+	ctx := context.Background()
+	itemType := useItemEntityType(t)
+	original, err := tRepos.Entities.Create(ctx, tGroup.ID, EntityCreate{
+		Name:         "duplicate-barcode-source",
+		EntityTypeID: itemType.ID,
+		Barcode:      "0012345",
+	})
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = tRepos.Entities.Delete(ctx, original.ID) })
+
+	duplicate, err := tRepos.Entities.Duplicate(ctx, tGroup.ID, original.ID, DuplicateOptions{})
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = tRepos.Entities.Delete(ctx, duplicate.ID) })
+	assert.Equal(t, "0012345", duplicate.Barcode)
+}
