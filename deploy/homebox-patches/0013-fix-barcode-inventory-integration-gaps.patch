+func TestCSVExportImportPreservesBarcodeAndAcceptsOlderFiles(t *testing.T) {
+	ctx := context.Background()
+
+	src, err := tRepos.Groups.GroupCreate(ctx, "csv-barcode-src-"+fk.Str(4), uuid.Nil)
+	require.NoError(t, err)
+	locationType, err := tRepos.EntityTypes.GetDefault(ctx, src.ID, true)
+	require.NoError(t, err)
+	itemType, err := tRepos.EntityTypes.GetDefault(ctx, src.ID, false)
+	require.NoError(t, err)
+	location, err := tRepos.Entities.Create(ctx, src.ID, repo.EntityCreate{
+		Name:         "Barcode Storage",
+		EntityTypeID: locationType.ID,
+	})
+	require.NoError(t, err)
+	_, err = tRepos.Entities.Create(ctx, src.ID, repo.EntityCreate{
+		ImportRef:    "barcode-roundtrip-ref",
+		Name:         "Barcode item",
+		ParentID:     location.ID,
+		EntityTypeID: itemType.ID,
+		Barcode:      "0012345",
+	})
+	require.NoError(t, err)
+
+	rows, err := tSvc.Entities.ExportCSV(ctx, src.ID, "https://homebox.example")
+	require.NoError(t, err)
+	header := rows[0]
+	barcodeCol := -1
+	nameCol := -1
+	for i, name := range header {
+		switch name {
+		case "HB.barcode":
+			barcodeCol = i
+		case "HB.name":
+			nameCol = i
+		}
+	}
+	require.NotEqual(t, -1, barcodeCol, "export must include the barcode column")
+	require.NotEqual(t, -1, nameCol, "export must include the name column")
+
+	var itemRow []string
+	for _, row := range rows[1:] {
+		if row[nameCol] == "Barcode item" {
+			itemRow = row
+			break
+		}
+	}
+	require.NotNil(t, itemRow)
+	assert.Equal(t, "0012345", itemRow[barcodeCol])
+
+	var csvBuf bytes.Buffer
+	writer := csv.NewWriter(&csvBuf)
+	require.NoError(t, writer.WriteAll([][]string{header, itemRow}))
+	require.NoError(t, writer.Error())
+	dst, err := tRepos.Groups.GroupCreate(ctx, "csv-barcode-dst-"+fk.Str(4), uuid.Nil)
+	require.NoError(t, err)
+	imported, err := tSvc.Entities.CsvImport(ctx, dst.ID, bytes.NewReader(csvBuf.Bytes()))
+	require.NoError(t, err)
+	require.Equal(t, 1, imported)
+	importedItem, err := tRepos.Entities.GetByRef(ctx, dst.ID, "barcode-roundtrip-ref")
+	require.NoError(t, err)
+	assert.Equal(t, "0012345", importedItem.Barcode)
+
+	legacyDst, err := tRepos.Groups.GroupCreate(ctx, "csv-barcode-legacy-"+fk.Str(4), uuid.Nil)
+	require.NoError(t, err)
+	legacyCSV := "HB.import_ref,HB.location,HB.name\nlegacy-barcode-ref,Legacy Storage,Older item\n"
+	legacyImported, err := tSvc.Entities.CsvImport(ctx, legacyDst.ID, strings.NewReader(legacyCSV))
+	require.NoError(t, err)
+	require.Equal(t, 1, legacyImported)
+	legacyItem, err := tRepos.Entities.GetByRef(ctx, legacyDst.ID, "legacy-barcode-ref")
+	require.NoError(t, err)
+	assert.Empty(t, legacyItem.Barcode)
+}
