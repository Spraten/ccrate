+import { describe, expect, test } from "vitest";
+import { removeUploadedPhotoPreview, uploadPhotoPreviewsOnce, type PhotoPreview } from "./photo-uploader";
+
+const preview = (revision: number): PhotoPreview => ({
+  id: "capture-1",
+  revision,
+  photoName: "camera.jpg",
+  file: new File([`revision-${revision}`], "camera.jpg", { type: "image/jpeg" }),
+  fileBase64: "data:image/jpeg;base64,",
+  primary: true,
+});
+
+describe("staged photo saves", () => {
+  test("reconciles by stable identity and revision after an upload resolves", async () => {
+    let resolveUpload!: (success: boolean) => void;
+    let current = [preview(0)];
+    const attempts: number[] = [];
+    const save = uploadPhotoPreviewsOnce(
+      current,
+      async photo => {
+        attempts.push(photo.revision ?? 0);
+        return await new Promise<boolean>(resolve => (resolveUpload = resolve));
+      },
+      photo => (current = removeUploadedPhotoPreview(current, photo))
+    );
+
+    current = [preview(1)];
+    resolveUpload(true);
+    await expect(save).resolves.toBe(true);
+    expect(current.map(photo => photo.revision)).toEqual([1]);
+    expect(attempts).toEqual([0]);
+  });
+
+  test("does not continue the queue after an uncertain upload", async () => {
+    const attempts: number[] = [];
+    await expect(
+      uploadPhotoPreviewsOnce(
+        [preview(0), { ...preview(0), id: "capture-2", photoName: "second.jpg" }],
+        async photo => {
+          attempts.push(photo.revision ?? 0);
+          return false;
+        },
+        () => undefined
+      )
+    ).resolves.toBe(false);
+    expect(attempts).toHaveLength(1);
+  });
+});
