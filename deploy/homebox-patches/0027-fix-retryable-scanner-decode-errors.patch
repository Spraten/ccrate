@@ -174,11 +174,19 @@ export function scannerStatusAfterFrame(
   error?: unknown
 ): ScannerStatus {
   if (hasResult) return "detected";
-  if (error instanceof NotFoundException) return current;
+  if (isRetryableBarcodeDecodeError(error)) return current;
   if (error) return "error";
   return current === "starting" ? "scanning" : current;
 }
 
+export function isRetryableBarcodeDecodeError(error: unknown): boolean {
+  return (
+    error instanceof NotFoundException ||
+    error instanceof ChecksumException ||
+    error instanceof FormatException
+  );
+}
