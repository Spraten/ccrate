+  test.each([new ChecksumException(), new FormatException()])("keeps incomplete barcode frames retryable", error => {
+    expect(isRetryableBarcodeDecodeError(error)).toBe(true);
+    expect(scannerStatusAfterFrame("scanning", false, error)).toBe("scanning");
+  });
+
+  test("does not treat real camera errors as retryable decode misses", () => {
