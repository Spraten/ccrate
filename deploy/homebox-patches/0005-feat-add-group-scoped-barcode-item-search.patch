@@ -0,0 +1,20 @@
+package v1
+
+import (
+	"net/http/httptest"
+	"testing"
+)
+
+func TestEntityBarcodeQueryValueTrimsSurroundingWhitespace(t *testing.T) {
+	req := httptest.NewRequest("GET", "/v1/entities?barcode=%200012345%20", nil)
+	if got := entityBarcodeQueryValue(req); got != "0012345" {
+		t.Fatalf("expected trimmed barcode preserving leading zeroes, got %q", got)
+	}
+}
+
+func TestEntityBarcodeQueryValueTreatsWhitespaceAsAbsent(t *testing.T) {
+	req := httptest.NewRequest("GET", "/v1/entities?barcode=%20%20", nil)
+	if got := entityBarcodeQueryValue(req); got != "" {
+		t.Fatalf("expected blank barcode to be omitted, got %q", got)
+	}
+}
