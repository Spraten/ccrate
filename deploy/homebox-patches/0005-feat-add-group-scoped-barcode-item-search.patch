+func TestEntityRepository_BarcodeQuery(t *testing.T) {
+	itemType := useItemEntityType(t)
+	ctx := context.Background()
+	barcode := "X9TEUJR4L"
+
+	create := func(name, code string) EntityOut {
+		t.Helper()
+		item, err := tRepos.Entities.Create(ctx, tGroup.ID, EntityCreate{
+			Name:         name,
+			EntityTypeID: itemType.ID,
+			Barcode:      code,
+		})
+		require.NoError(t, err)
+		t.Cleanup(func() { _ = tRepos.Entities.Delete(ctx, item.ID) })
+		return item
+	}
+
+	first := create("barcode-match-one", barcode)
+	second := create("barcode-match-two", barcode)
+	create("barcode-different", "X9TEUJR4M")
+
+	result, err := tRepos.Entities.QueryByGroup(ctx, tGroup.ID, EntityQuery{
+		Page: -1, PageSize: -1, Barcode: "  " + barcode + "  ",
+	})
+	require.NoError(t, err)
+	assert.Equal(t, 2, result.Total)
+	assert.ElementsMatch(t, []uuid.UUID{first.ID, second.ID}, []uuid.UUID{result.Items[0].ID, result.Items[1].ID})
+
+	var pagedIDs []uuid.UUID
+	for page := 1; page <= 2; page++ {
+		paged, err := tRepos.Entities.QueryByGroup(ctx, tGroup.ID, EntityQuery{
+			Page: page, PageSize: 1, Barcode: barcode,
+		})
+		require.NoError(t, err)
+		require.Len(t, paged.Items, 1)
+		assert.Equal(t, 2, paged.Total)
+		pagedIDs = append(pagedIDs, paged.Items[0].ID)
+	}
+	assert.ElementsMatch(t, []uuid.UUID{first.ID, second.ID}, pagedIDs)
+}
