+func Test_EntityBarcodeQueryByGroupDoesNotLeakAcrossGroups(t *testing.T) {
+	ctx := context.Background()
+	ownType := useItemEntityType(t)
+	foreignGID, _, foreignTypeID := makeForeignGroup(t)
+	barcode := "X9TEUJR4L"
+
+	own, err := tRepos.Entities.Create(ctx, tGroup.ID, EntityCreate{
+		Name:         "own-barcode-match",
+		EntityTypeID: ownType.ID,
+		Barcode:      barcode,
+	})
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = tRepos.Entities.Delete(ctx, own.ID) })
+
+	foreign, err := tRepos.Entities.Create(ctx, foreignGID, EntityCreate{
+		Name:         "foreign-barcode-match",
+		EntityTypeID: foreignTypeID,
+		Barcode:      barcode,
+	})
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = tRepos.Entities.Delete(ctx, foreign.ID) })
+
+	result, err := tRepos.Entities.QueryByGroup(ctx, tGroup.ID, EntityQuery{
+		Page: -1, PageSize: -1, Barcode: barcode,
+	})
+	require.NoError(t, err)
+	require.Len(t, result.Items, 1)
+	assert.Equal(t, 1, result.Total)
+	assert.Equal(t, own.ID, result.Items[0].ID)
+}
