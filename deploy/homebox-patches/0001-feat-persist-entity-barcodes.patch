 func (r *EntityRepository) Create(ctx context.Context, gid uuid.UUID, data EntityCreate) (EntityOut, error) {
 	ctx, span := entityTracer().Start(ctx, "repo.EntityRepository.Create",
 		trace.WithAttributes(
@@ -992,6 +1004,10 @@ func (r *EntityRepository) Create(ctx context.Context, gid uuid.UUID, data Entit
 		recordSpanError(span, err)
 		return EntityOut{}, err
 	}
+	barcode, err := normalizeBarcode(data.Barcode)
+	if err != nil {
+		return EntityOut{}, err
+	}
 
 	// Reject cross-group UUIDs in the request body before any write hits the DB.
 	// Without these checks, an authenticated caller in group A could reparent
@@ -1017,6 +1033,9 @@ func (r *EntityRepository) Create(ctx context.Context, gid uuid.UUID, data Entit
 		SetDescription(data.Description).
 		SetGroupID(gid).
 		SetAssetID(int64(data.AssetID))
+	if barcode != "" {
+		q.SetBarcode(barcode)
+	}
 
 	if data.ParentID != uuid.Nil {
 		q.SetParentID(data.ParentID)
@@ -1463,6 +1482,10 @@ func (r *EntityRepository) UpdateByGroup(ctx context.Context, gid uuid.UUID, dat
 		recordSpanError(span, err)
 		return EntityOut{}, err
 	}
+	barcode, err := normalizeBarcode(data.Barcode)
+	if err != nil {
+		return EntityOut{}, err
+	}
 
 	// See EntityRepository.Create for the rationale on these cross-group
 	// reference checks. Applied before the update so a rejected request never
@@ -1499,6 +1522,11 @@ func (r *EntityRepository) UpdateByGroup(ctx context.Context, gid uuid.UUID, dat
 		SetQuantity(data.Quantity).
 		SetAssetID(int64(data.AssetID)).
 		SetSyncChildEntityLocations(data.SyncChildEntityLocations)
+	if barcode == "" {
+		q.ClearBarcode()
+	} else {
+		q.SetBarcode(barcode)
+	}
 
 	// Date fields are nullable. Writing types.Date{}.Time() would persist
 	// the 0001-01-01 sentinel that ZeroOutTimeFields then has to chase —
