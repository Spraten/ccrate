+func normalizeBarcode(value string) (string, error) {
+	value = strings.TrimSpace(value)
+	if len([]rune(value)) > 80 {
+		return "", fmt.Errorf("barcode: must be at most 80 characters")
+	}
+	return value, nil
+}
