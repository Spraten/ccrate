+func TestEntityRepository_Barcode(t *testing.T) {
+	itemType := useItemEntityType(t)
+
+	for _, barcode := range []string{"X9TEUJR4L", "0012345"} {
+		t.Run(barcode, func(t *testing.T) {
+			item := entityFactory()
+			item.EntityTypeID = itemType.ID
+			item.Barcode = "  " + barcode + "  "
+
+			created, err := tRepos.Entities.Create(context.Background(), tGroup.ID, item)
+			require.NoError(t, err)
+			assert.Equal(t, barcode, created.Barcode)
+
+			fetched, err := tRepos.Entities.GetOne(context.Background(), created.ID)
+			require.NoError(t, err)
+			assert.Equal(t, barcode, fetched.Barcode)
+
+			update := EntityUpdate{ID: created.ID, Name: created.Name, Barcode: barcode}
+			if created.EntityType != nil {
+				update.EntityTypeID = created.EntityType.ID
+			}
+			updated, err := tRepos.Entities.UpdateByGroup(context.Background(), tGroup.ID, update)
+			require.NoError(t, err)
+			assert.Equal(t, barcode, updated.Barcode)
+
+			fetched, err = tRepos.Entities.GetOne(context.Background(), created.ID)
+			require.NoError(t, err)
+			assert.Equal(t, barcode, fetched.Barcode)
+
+			// An older client that omits the optional property clears it to SQL NULL
+			// and still receives the backward-compatible empty string in the response.
+			update.Barcode = ""
+			updated, err = tRepos.Entities.UpdateByGroup(context.Background(), tGroup.ID, update)
+			require.NoError(t, err)
+			assert.Empty(t, updated.Barcode)
+			fetched, err = tRepos.Entities.GetOne(context.Background(), created.ID)
+			require.NoError(t, err)
+			assert.Empty(t, fetched.Barcode)
+			require.NoError(t, tRepos.Entities.Delete(context.Background(), created.ID))
+		})
+	}
+}
+
+func TestEntityRepository_Barcode_MaxLen(t *testing.T) {
+	item := entityFactory()
+	item.EntityTypeID = useItemEntityType(t).ID
+	item.Barcode = strings.Repeat("x", 81)
+
+	_, err := tRepos.Entities.Create(context.Background(), tGroup.ID, item)
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "barcode: must be at most 80 characters")
+}
