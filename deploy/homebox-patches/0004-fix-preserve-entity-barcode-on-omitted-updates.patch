--- /dev/null
+++ b/backend/internal/web/adapters/decoders_test.go
@@ -0,0 +1,30 @@
+package adapters_test
+
+import (
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"github.com/sysadminsmedia/homebox/backend/internal/data/repo"
+	"github.com/sysadminsmedia/homebox/backend/internal/web/adapters"
+)
+
+func TestDecodeBodyTrimsBarcodeBeforeLengthValidation(t *testing.T) {
+	barcode := strings.Repeat("é", 80)
+	body := `{"name":"Test entity","barcode":"  ` + barcode + `  "}`
+	r := httptest.NewRequest("POST", "/", strings.NewReader(body))
+
+	decoded, err := adapters.DecodeBody[repo.EntityCreate](r)
+	require.NoError(t, err)
+	require.Equal(t, barcode, decoded.Barcode)
+}
+
+func TestDecodeBodyNullBarcodeMeansExplicitClear(t *testing.T) {
+	r := httptest.NewRequest("PUT", "/", strings.NewReader(`{"name":"Test entity","barcode":null}`))
+
+	decoded, err := adapters.DecodeBody[repo.EntityUpdate](r)
+	require.NoError(t, err)
+	require.NotNil(t, decoded.Barcode)
+	require.Empty(t, *decoded.Barcode)
+}
