+func (data *EntityUpdate) UnmarshalJSON(raw []byte) error {
+	type entityUpdateJSON EntityUpdate
+	var decoded entityUpdateJSON
+	if err := json.Unmarshal(raw, &decoded); err != nil {
+		return err
+	}
+	*data = EntityUpdate(decoded)
+
+	var fields map[string]json.RawMessage
+	if err := json.Unmarshal(raw, &fields); err != nil {
+		return err
+	}
+	if barcode, ok := fields["barcode"]; ok && bytes.Equal(bytes.TrimSpace(barcode), []byte("null")) {
+		clear := ""
+		data.Barcode = &clear
+	}
+	return nil
+}
+
 type (
 	FieldQuery struct {
 		Name  string
