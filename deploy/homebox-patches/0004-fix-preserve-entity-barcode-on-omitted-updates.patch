+		SerialNumber string  `json:"serialNumber"`
+		Barcode      *string `json:"barcode,omitempty" validate:"omitempty,max=80" extensions:"x-nullable"`
+		ModelNumber  string  `json:"modelNumber"`
+		Manufacturer string  `json:"manufacturer"`
 
 		// Warranty
 		LifetimeWarranty bool       `json:"lifetimeWarranty"`
@@ -987,6 +1008,18 @@ func normalizeBarcode(value string) (string, error) {
 	return value, nil
 }
 
+func (data *EntityCreate) NormalizeBody() {
+	data.Barcode = strings.TrimSpace(data.Barcode)
+}
+
+func (data *EntityUpdate) NormalizeBody() {
+	if data.Barcode == nil {
+		return
+	}
+	barcode := strings.TrimSpace(*data.Barcode)
+	data.Barcode = &barcode
+}
+
 func (r *EntityRepository) Create(ctx context.Context, gid uuid.UUID, data EntityCreate) (EntityOut, error) {
 	ctx, span := entityTracer().Start(ctx, "repo.EntityRepository.Create",
 		trace.WithAttributes(
@@ -1482,9 +1515,13 @@ func (r *EntityRepository) UpdateByGroup(ctx context.Context, gid uuid.UUID, dat
 		recordSpanError(span, err)
 		return EntityOut{}, err
 	}
-	barcode, err := normalizeBarcode(data.Barcode)
-	if err != nil {
-		return EntityOut{}, err
+	var barcode *string
+	if data.Barcode != nil {
+		value, err := normalizeBarcode(*data.Barcode)
+		if err != nil {
+			return EntityOut{}, err
+		}
+		barcode = &value
 	}
 
 	// See EntityRepository.Create for the rationale on these cross-group
@@ -1522,10 +1559,12 @@ func (r *EntityRepository) UpdateByGroup(ctx context.Context, gid uuid.UUID, dat
 		SetQuantity(data.Quantity).
 		SetAssetID(int64(data.AssetID)).
 		SetSyncChildEntityLocations(data.SyncChildEntityLocations)
-	if barcode == "" {
-		q.ClearBarcode()
-	} else {
-		q.SetBarcode(barcode)
+	if barcode != nil {
+		if *barcode == "" {
+			q.ClearBarcode()
+		} else {
+			q.SetBarcode(*barcode)
+		}
 	}
 
 	// Date fields are nullable. Writing types.Date{}.Time() would persist
