+func TestEntityRepository_BarcodeRuneLength(t *testing.T) {
+	itemType := useItemEntityType(t)
+	barcode := strings.Repeat("é", 80)
+	item := entityFactory()
+	item.EntityTypeID = itemType.ID
+	item.Barcode = barcode
+
+	created, err := tRepos.Entities.Create(context.Background(), tGroup.ID, item)
+	require.NoError(t, err)
+	assert.Equal(t, barcode, created.Barcode)
+
+	update := EntityUpdate{ID: created.ID, Name: created.Name, EntityTypeID: itemType.ID, Barcode: &barcode}
+	updated, err := tRepos.Entities.UpdateByGroup(context.Background(), tGroup.ID, update)
+	require.NoError(t, err)
+	assert.Equal(t, barcode, updated.Barcode)
+
+	tooLong := strings.Repeat("é", 81)
+	item.Barcode = tooLong
+	_, err = tRepos.Entities.Create(context.Background(), tGroup.ID, item)
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "barcode: must be at most 80 characters")
+
+	update.Barcode = &tooLong
+	_, err = tRepos.Entities.UpdateByGroup(context.Background(), tGroup.ID, update)
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "barcode: must be at most 80 characters")
+	require.NoError(t, tRepos.Entities.Delete(context.Background(), created.ID))
+}
