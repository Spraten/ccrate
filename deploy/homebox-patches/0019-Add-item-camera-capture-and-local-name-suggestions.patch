@@ -0,0 +1,71 @@
+import { describe, expect, test } from "vitest";
+import { canvasToPhotoFile, recognizeNameFromFileLocally, recognizeNameLocally } from "./camera";
+
+describe("local camera helpers", () => {
+  test("converts a captured canvas to a JPEG photo file for the existing preview flow", async () => {
+    const canvas = {
+      toBlob(callback: BlobCallback) {
+        callback(new Blob(["captured frame"], { type: "image/jpeg" }));
+      },
+    } as HTMLCanvasElement;
+
+    const file = await canvasToPhotoFile(canvas, "item-photo.jpg");
+
+    expect(file.name).toBe("item-photo.jpg");
+    expect(file.type).toBe("image/jpeg");
+    expect(file.size).toBeGreaterThan(0);
+  });
+
+  test("rejects a capture when the browser cannot create an image blob", async () => {
+    const canvas = { toBlob: (callback: BlobCallback) => callback(null) } as HTMLCanvasElement;
+    await expect(canvasToPhotoFile(canvas, "item-photo.jpg")).rejects.toThrow("Failed to capture camera frame");
+  });
+
+  test("returns locally recognized text as a single editable name suggestion", async () => {
+    const source = {} as HTMLCanvasElement;
+    class Detector {
+      async detect(image: CanvasImageSource) {
+        expect(image).toBe(source);
+        return [{ rawValue: " ACME " }, { rawValue: "Cordless Drill" }];
+      }
+    }
+
+    await expect(recognizeNameLocally(source, Detector)).resolves.toBe("ACME Cordless Drill");
+  });
+
+  test("recognizes text from an image file locally and releases the decoded bitmap", async () => {
+    let closed = false;
+    const bitmap = { close: () => (closed = true) } as ImageBitmap;
+    class Detector {
+      async detect() {
+        return [{ rawValue: "  Model XR-4 " }];
+      }
+    }
+
+    await expect(
+      recognizeNameFromFileLocally(new Blob(["image"]), Detector, async () => bitmap)
+    ).resolves.toBe("Model XR-4");
+    expect(closed).toBe(true);
+  });
+
+  test("gracefully reports when local text recognition is unavailable or finds no text", async () => {
+    const source = {} as HTMLCanvasElement;
+    await expect(recognizeNameLocally(source, undefined)).resolves.toBeNull();
+
+    let bitmapRequested = false;
+    const createBitmap = async () => {
+      bitmapRequested = true;
+      throw new Error("Unsupported");
+    };
+    await expect(recognizeNameFromFileLocally(new Blob(["image"]), undefined, createBitmap)).resolves.toBeNull();
+    expect(bitmapRequested).toBe(false);
+
+    class EmptyDetector {
+      async detect() {
+        return [{ rawValue: "  " }];
+      }
+    }
+
+    await expect(recognizeNameLocally(source, EmptyDetector)).resolves.toBeNull();
+  });
+});
diff --git a/frontend/components/Form/camera.ts b/frontend/components/Form/camera.ts
new file mode 100644
index 00000000..ee914632
--- /dev/null
+++ b/frontend/components/Form/camera.ts
@@ -0,0 +1,56 @@
+export interface LocalTextDetection {
+  rawValue: string;
+}
+
+export interface LocalTextDetector {
+  detect(source: CanvasImageSource): Promise<LocalTextDetection[]>;
+}
+
+export type LocalTextDetectorConstructor = new () => LocalTextDetector;
+
+type TextDetectorGlobal = typeof globalThis & {
+  TextDetector?: LocalTextDetectorConstructor;
+};
+
+export async function canvasToPhotoFile(canvas: HTMLCanvasElement, fileName: string): Promise<File> {
+  const blob = await new Promise<Blob>((resolve, reject) => {
+    canvas.toBlob(
+      result => (result ? resolve(result) : reject(new Error("Failed to capture camera frame"))),
+      "image/jpeg",
+      0.9
+    );
+  });
+
+  return new File([blob], fileName, { type: blob.type || "image/jpeg" });
+}
+
+export async function recognizeNameLocally(
+  source: CanvasImageSource,
+  Detector: LocalTextDetectorConstructor | undefined = (globalThis as TextDetectorGlobal).TextDetector
+): Promise<string | null> {
+  if (!Detector) return null;
+
+  const detections = await new Detector().detect(source);
+  const suggestion = detections
+    .map(detection => detection.rawValue.trim())
+    .filter(Boolean)
+    .join(" ")
+    .replace(/\s+/g, " ")
+    .trim();
+
+  return suggestion || null;
+}
+export async function recognizeNameFromFileLocally(
+  file: Blob,
+  Detector: LocalTextDetectorConstructor | undefined = (globalThis as TextDetectorGlobal).TextDetector,
+  createBitmap: (source: ImageBitmapSource) => Promise<ImageBitmap> = globalThis.createImageBitmap
+): Promise<string | null> {
+  if (!Detector || typeof createBitmap !== "function") return null;
+
+  const bitmap = await createBitmap(file);
+  try {
+    return await recognizeNameLocally(bitmap, Detector);
+  } finally {
+    bitmap.close();
+  }
+}
