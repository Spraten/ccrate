diff --git a/frontend/components/Form/CameraCaptureDialog.vue b/frontend/components/Form/CameraCaptureDialog.vue
new file mode 100644
index 00000000..555e8bf9
--- /dev/null
+++ b/frontend/components/Form/CameraCaptureDialog.vue
@@ -0,0 +1,166 @@
+<template>
+  <DialogRoot :open="open" @update:open="emit('update:open', $event)">
+    <DialogContent class="w-full sm:max-w-2xl">
+      <DialogHeader>
+        <DialogTitle>{{ t("components.form.camera.title") }}</DialogTitle>
+      </DialogHeader>
+
+      <p
+        v-if="errorMessage"
+        class="rounded-md border border-destructive bg-destructive/10 p-3 text-sm text-destructive"
+        role="alert"
+      >
+        {{ errorMessage }}
+      </p>
+      <video
+        ref="video"
+        v-show="!capturedFile"
+        class="aspect-video w-full rounded-md bg-muted object-cover"
+        autoplay
+        muted
+        playsinline
+      />
+      <img
+        v-if="previewUrl"
+        :src="previewUrl"
+        class="aspect-video w-full rounded-md bg-muted object-contain"
+        :alt="t('components.form.camera.preview_alt')"
+      />
+
+      <DialogFooter>
+        <Button type="button" variant="outline" @click="emit('update:open', false)">
+          {{ t("global.cancel") }}
+        </Button>
+        <Button v-if="!capturedFile" type="button" :disabled="!cameraReady" @click="capturePhoto">
+          <MdiCameraOutline class="mr-2 size-4" />
+          {{ t("components.form.camera.capture") }}
+        </Button>
+        <template v-else>
+          <Button type="button" variant="outline" @click="retakePhoto">
+            {{ t("components.form.camera.retake") }}
+          </Button>
+          <Button type="button" @click="usePhoto">
+            {{ t("components.form.camera.use_photo") }}
+          </Button>
+        </template>
+      </DialogFooter>
+    </DialogContent>
+  </DialogRoot>
+</template>
+
+<script setup lang="ts">
+  import { nextTick, onBeforeUnmount, ref, watch } from "vue";
+  import { useI18n } from "vue-i18n";
+  import { Button } from "~/components/ui/button";
+  import { DialogContent, DialogFooter, DialogHeader, DialogTitle } from "~/components/ui/dialog";
+  import { DialogRoot } from "reka-ui";
+  import MdiCameraOutline from "~icons/mdi/camera-outline";
+  import { canvasToPhotoFile } from "./camera";
+
+  const props = defineProps<{ open: boolean }>();
+  const emit = defineEmits<{
+    (e: "update:open", open: boolean): void;
+    (e: "captured", file: File): void;
+  }>();
+
+  const { t } = useI18n();
+  const video = ref<HTMLVideoElement>();
+  const cameraReady = ref(false);
+  const errorMessage = ref("");
+  const capturedFile = ref<File>();
+  const previewUrl = ref("");
+  let stream: MediaStream | null = null;
+
+  async function startCamera() {
+    errorMessage.value = "";
+    cameraReady.value = false;
+    await nextTick();
+
+    if (!navigator.mediaDevices?.getUserMedia) {
+      errorMessage.value = t("components.form.camera.unavailable");
+      return;
+    }
+
+    try {
+      const nextStream = await navigator.mediaDevices.getUserMedia({
+        video: { facingMode: { ideal: "environment" } },
+        audio: false,
+      });
+      if (!props.open) {
+        nextStream.getTracks().forEach(track => track.stop());
+        return;
+      }
+      stream = nextStream;
+      if (!video.value) throw new Error("Camera preview is unavailable");
+      video.value.srcObject = stream;
+      await video.value.play();
+      cameraReady.value = true;
+    } catch {
+      errorMessage.value = t("components.form.camera.permission_error");
+      stopCamera();
+    }
+  }
+
+  function stopCamera() {
+    cameraReady.value = false;
+    stream?.getTracks().forEach(track => track.stop());
+    stream = null;
+    if (video.value) video.value.srcObject = null;
+  }
+
+  function clearPreview() {
+    if (previewUrl.value) URL.revokeObjectURL(previewUrl.value);
+    previewUrl.value = "";
+    capturedFile.value = undefined;
+  }
+
+  async function capturePhoto() {
+    if (!video.value?.videoWidth || !video.value.videoHeight) return;
+    const canvas = document.createElement("canvas");
+    canvas.width = video.value.videoWidth;
+    canvas.height = video.value.videoHeight;
+    const context = canvas.getContext("2d");
+    if (!context) {
+      errorMessage.value = t("components.form.camera.capture_error");
+      return;
+    }
+
+    context.drawImage(video.value, 0, 0, canvas.width, canvas.height);
+    try {
+      const timestamp = new Date().toISOString().replace(/[:.]/g, "-");
+      capturedFile.value = await canvasToPhotoFile(canvas, `camera-${timestamp}.jpg`);
+      previewUrl.value = URL.createObjectURL(capturedFile.value);
+      stopCamera();
+    } catch {
+      errorMessage.value = t("components.form.camera.capture_error");
+    }
+  }
+
+  function retakePhoto() {
+    clearPreview();
+    void startCamera();
+  }
+
+  function usePhoto() {
+    if (!capturedFile.value) return;
+    emit("captured", capturedFile.value);
+    emit("update:open", false);
+  }
+
+  watch(
+    () => props.open,
+    open => {
+      if (open) void startCamera();
+      else {
+        stopCamera();
+        clearPreview();
+        errorMessage.value = "";
+      }
+    }
+  );
+
+  onBeforeUnmount(() => {
+    stopCamera();
+    clearPreview();
+  });
+</script>
diff --git a/frontend/components/Form/camera.test.ts b/frontend/components/Form/camera.test.ts
