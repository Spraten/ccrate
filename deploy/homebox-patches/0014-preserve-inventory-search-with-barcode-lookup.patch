+func TestEntitySearchQueryParsesAssetIDWithoutChangingSearch(t *testing.T) {
+	req := httptest.NewRequest("GET", "/v1/entities?q=%23001234", nil)
+	search, assetID := entitySearchQuery(req)
+	if search != "" {
+		t.Fatalf("expected asset ID query to clear text search, got %q", search)
+	}
+	if assetID != 1234 {
+		t.Fatalf("expected asset ID 1234, got %d", assetID)
+	}
+
+	req = httptest.NewRequest("GET", "/v1/entities?q=001234", nil)
+	search, assetID = entitySearchQuery(req)
+	if search != "001234" || !assetID.Nil() {
+		t.Fatalf("expected numeric text query to remain a text search, got %q with asset ID %d", search, assetID)
+	}
+}
