+func TestEntityRepository_SearchMatchesExactBarcodeAndPreservesTextSearch(t *testing.T) {
+	ctx := context.Background()
+	itemType := useItemEntityType(t)
+	foreignGID, _, foreignTypeID := makeForeignGroup(t)
+
+	create := func(gid uuid.UUID, typeID uuid.UUID, data EntityCreate) EntityOut {
+		t.Helper()
+		data.EntityTypeID = typeID
+		item, err := tRepos.Entities.Create(ctx, gid, data)
+		require.NoError(t, err)
+		t.Cleanup(func() { _ = tRepos.Entities.Delete(ctx, item.ID) })
+		return item
+	}
+
+	alphanumeric := create(tGroup.ID, itemType.ID, EntityCreate{
+		Name:    "Alphanumeric code item",
+		Barcode: "X9TEUJR4L",
+	})
+	leadingZero := create(tGroup.ID, itemType.ID, EntityCreate{
+		Name:    "Leading zero code item",
+		Barcode: "0012345",
+	})
+	metadata := create(tGroup.ID, itemType.ID, EntityCreate{
+		Name:       "Voltage adapter",
+		ModelNumber: "123",
+	})
+	foreign := create(foreignGID, foreignTypeID, EntityCreate{
+		Name:    "Foreign barcode item",
+		Barcode: "X9TEUJR4L",
+	})
+
+	search := func(gid uuid.UUID, value string) []EntitySummary {
+		t.Helper()
+		result, err := tRepos.Entities.QueryByGroup(ctx, gid, EntityQuery{
+			Page: -1, PageSize: -1, Search: value,
+		})
+		require.NoError(t, err)
+		return result.Items
+	}
+
+	assertIDs := func(gid uuid.UUID, value string, want ...uuid.UUID) {
+		t.Helper()
+		items := search(gid, value)
+		got := make([]uuid.UUID, len(items))
+		for i, item := range items {
+			got[i] = item.ID
+		}
+		assert.ElementsMatch(t, want, got, "search %q in group %s", value, gid)
+	}
+
+	assertIDs(tGroup.ID, " X9TEUJR4L ", alphanumeric.ID)
+	assertIDs(tGroup.ID, "0012345", leadingZero.ID)
+	assertIDs(tGroup.ID, "12345")
+	assertIDs(tGroup.ID, "123", metadata.ID)
+	assertIDs(tGroup.ID, "X9TEUJR4L", alphanumeric.ID)
+	assertIDs(foreignGID, "X9TEUJR4L", foreign.ID)
+}
