 export type ScannerStatus = "starting" | "scanning" | "detected" | "error";
+export type BarcodeScanResult = { type: "barcode"; barcode: string } | { type: "navigate" };
+export type BarcodePageLookup = (page: number, append: boolean) => unknown;
 
 export function attachBarcode<T extends object>(payload: T, value: string): T & { barcode?: string } {
   const barcode = value.trim();
@@ -77,6 +79,45 @@ export function handleBarcodeEnter(event: Pick<KeyboardEvent, "preventDefault" |
   void lookup();
 }
 
+export function routeBarcodeScanResult(
+  result: BarcodeScanResult,
+  close: (result: BarcodeScanResult) => boolean,
+  openItem: (barcode: string) => void
+): boolean {
+  const handledByCaller = close(result);
+  if (!handledByCaller && result.type === "barcode") openItem(result.barcode);
+  return handledByCaller;
+}
+
+export function startBarcodeLookup(lookup: BarcodePageLookup): unknown {
+  return lookup(1, false);
+}
+
+export function handleBarcodeLookupClick(lookup: BarcodePageLookup): unknown {
+  return startBarcodeLookup(lookup);
+}
+
+export function applyInitialBarcodeParam(
+  barcode: string | undefined,
+  draft: { barcode: string },
+  lookup: BarcodePageLookup
+): boolean {
+  if (!barcode) return false;
+  prefillBarcodeDraft(draft, barcode);
+  startBarcodeLookup(lookup);
+  return true;
+}
+
+export function loadNextBarcodePage(
+  currentPage: number,
+  total: number,
+  pageSize: number,
+  lookup: BarcodePageLookup
+): unknown {
+  if (currentPage >= duplicatePageCount(total, pageSize)) return undefined;
+  return lookup(currentPage + 1, true);
+}
+
 export function barcodeDraftKey(draft: Record<string, unknown>): string {
   return JSON.stringify(draft);
 }
