 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/frontend/components/App/ThemePicker.vue b/frontend/components/App/ThemePicker.vue
--- a/frontend/components/App/ThemePicker.vue
+++ b/frontend/components/App/ThemePicker.vue
@@ -4,7 +4,7 @@
   import { useTheme } from "~/composables/use-theme";
   import { Button } from "~/components/ui/button";
 
-  const { themeMode, setTheme, setThemeMode } = useTheme();
+  const { theme: selectedTheme, themeMode, setTheme, setThemeMode } = useTheme();
   const appearanceModes: { value: ThemeMode; label: string }[] = [
     { value: "light", label: "profile.theme_mode_light" },
     { value: "dark", label: "profile.theme_mode_dark" },
@@ -32,17 +32,19 @@
     </div>
 
     <div class="homebox grid grid-cols-1 gap-4 font-sans sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5">
