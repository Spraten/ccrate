@@ -58,4 +58,29 @@ describe("flatTree", () => {
       "shelf",
     ]);
   });
+
+  test("keeps matching locations visible with full paths while searching", () => {
+    const locations = flatTree([
+      {
+        id: "home",
+        name: "Home",
+        type: "location",
+        children: [
+          { id: "office", name: "Office", type: "location", children: [] },
+          {
+            id: "garage",
+            name: "Garage",
+            type: "location",
+            children: [{ id: "office-2", name: "Office", type: "location", children: [] }],
+          },
+        ],
+      },
+    ]);
+    const searchResults = locations.filter(location => location.name === "Office");
+
+    expect(getVisibleLocations(searchResults, new Set(), true).map(location => location.treeString)).toEqual([
+      "Home > Office",
+      "Home > Garage > Office",
+    ]);
+  });
 });
