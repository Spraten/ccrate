+export function scannerStatusMessage(
+  status: ScannerStatus,
+  barcode: string,
+  translate: (key: string, values?: { barcode: string }) => string
+): string {
+  return status === "detected"
+    ? translate("scanner.detected_status", { barcode })
+    : translate(`scanner.${status}`);
+}
