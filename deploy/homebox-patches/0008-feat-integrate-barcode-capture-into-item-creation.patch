@@ -0,0 +1,97 @@
+import { describe, expect, test, vi } from "vitest";
+import { NotFoundException } from "@zxing/library";
+import type { BarcodeProduct, EntitySummary } from "~~/lib/api/types/data-contracts";
+import {
+  applyBarcodeCandidate,
+  attachBarcode,
+  lookupBarcodeItems,
+  lookupBarcodeProducts,
+  scannerStatusAfterFrame,
+  type BarcodeDraft,
+} from "./barcode";
+
+describe("item barcode helpers", () => {
+  test("keeps a manually entered alphanumeric code and leading zeroes in create data", () => {
+    expect(attachBarcode({ name: "Heat shrink tubing" }, "  X9TEUJR4L ")).toEqual({
+      name: "Heat shrink tubing",
+      barcode: "X9TEUJR4L",
+    });
+    expect(attachBarcode({}, " 0012345 ")).toEqual({ barcode: "0012345" });
+  });
+
+  test("leaves an empty optional barcode out and rejects values over 80 characters", () => {
+    expect(attachBarcode({ name: "Item" }, " ")).toEqual({ name: "Item" });
+    expect(() => attachBarcode({ name: "Item" }, "x".repeat(81))).toThrow(RangeError);
+  });
+
+  test("reports lookup miss without blocking manual creation", async () => {
+    const search = vi.fn().mockResolvedValue({ data: [], error: null });
+    await expect(lookupBarcodeProducts("0012345", search)).resolves.toEqual({ status: "not-found", products: [] });
+    expect(search).toHaveBeenCalledWith("0012345");
+  });
+
+  test("reports provider errors without throwing", async () => {
+    const search = vi.fn().mockRejectedValue(new Error("offline"));
+    await expect(lookupBarcodeProducts("123456", search)).resolves.toEqual({ status: "error", products: [] });
+  });
+
+  test("reports a returned provider error without throwing", async () => {
+    const search = vi.fn().mockResolvedValue({ data: undefined, error: new Error("offline") });
+    await expect(lookupBarcodeProducts("123456", search)).resolves.toEqual({ status: "error", products: [] });
+  });
+
+  test("keeps all exact duplicate matches available for review", async () => {
+    const matches = [{ id: "one" }, { id: "two" }] as unknown as EntitySummary[];
+    const search = vi.fn().mockResolvedValue({ data: { items: matches }, error: null });
+    await expect(lookupBarcodeItems("X9TEUJR4L", search)).resolves.toEqual(matches);
+    expect(search).toHaveBeenCalledWith("X9TEUJR4L");
+  });
+
+  test("only fills blank fields when a product candidate is explicitly chosen", () => {
+    const draft: BarcodeDraft = { name: "", description: "", manufacturer: "", modelNumber: "" };
+    const candidate = {
+      barcode: "0012345",
+      imageBase64: "",
+      imageURL: "",
+      item: {
+        name: "Heat shrink tubing",
+        description: "560 piece assortment",
+        entityTypeId: "",
+        quantity: 1,
+        tagIds: [],
+      },
+      manufacturer: "Eventronic",
+      modelNumber: "ET1001",
+      notes: "",
+      search_engine_name: "catalog",
+    } satisfies BarcodeProduct;
+    applyBarcodeCandidate(draft, candidate);
+    expect(draft).toEqual({
+      name: "Heat shrink tubing",
+      description: "560 piece assortment",
+      manufacturer: "Eventronic",
+      modelNumber: "ET1001",
+    });
+
+    draft.name = "My edited title";
+    draft.description = "My notes";
+    applyBarcodeCandidate(draft, {
+      ...candidate,
+      item: { ...candidate.item, name: "Catalog title", description: "Catalog description" },
+      manufacturer: "Catalog maker",
+      modelNumber: "CAT-01",
+    });
+    expect(draft.name).toBe("My edited title");
+    expect(draft.description).toBe("My notes");
+  });
+
+  test("keeps ordinary not-found camera frames in scanning state", () => {
+    expect(scannerStatusAfterFrame("scanning", false, new NotFoundException())).toBe("scanning");
+  });
+
+  test("moves scanner state from startup to scanning, detected, or actionable error", () => {
+    expect(scannerStatusAfterFrame("starting", false)).toBe("scanning");
+    expect(scannerStatusAfterFrame("scanning", true)).toBe("detected");
+    expect(scannerStatusAfterFrame("scanning", false, new Error("camera failure"))).toBe("error");
+  });
+});
diff --git a/frontend/components/Entity/barcode.ts b/frontend/components/Entity/barcode.ts
new file mode 100644
index 00000000..c6aabb9c
--- /dev/null
+++ b/frontend/components/Entity/barcode.ts
@@ -0,0 +1,64 @@
+import type { BarcodeProduct, EntitySummary } from "~~/lib/api/types/data-contracts";
+import { NotFoundException } from "@zxing/library";
+
+export type BarcodeDraft = {
+  name: string;
+  description: string;
+  manufacturer: string;
+  modelNumber: string;
+};
+
+export type ScannerStatus = "starting" | "scanning" | "detected" | "error";
+
+export function attachBarcode<T extends object>(payload: T, value: string): T & { barcode?: string } {
+  const barcode = value.trim();
+  if (barcode.length > 80) throw new RangeError("Barcode must be 80 characters or fewer");
+  return barcode ? { ...payload, barcode } : payload;
+}
+
+export async function lookupBarcodeProducts(
+  value: string,
+  search: (barcode: string) => Promise<{ data?: BarcodeProduct[]; error?: unknown }>
+): Promise<{ status: "found" | "not-found" | "unsupported" | "error"; products: BarcodeProduct[] }> {
+  const barcode = value.trim();
+  if (!/^\d+$/.test(barcode)) return { status: "unsupported", products: [] };
+
+  try {
+    const result = await search(barcode);
+    if (result.error) return { status: "error", products: [] };
+    const products = result.data ?? [];
+    return { status: products.length ? "found" : "not-found", products };
+  } catch {
+    return { status: "error", products: [] };
+  }
+}
+
+export async function lookupBarcodeItems(
+  barcode: string,
+  search: (barcode: string) => Promise<{ data?: { items?: EntitySummary[] }; error?: unknown }>
+): Promise<EntitySummary[]> {
+  try {
+    const result = await search(barcode);
+    return result.error ? [] : (result.data?.items ?? []);
+  } catch {
+    return [];
+  }
+}
+
+export function applyBarcodeCandidate(draft: BarcodeDraft, product: BarcodeProduct) {
+  if (!draft.name.trim()) draft.name = product.item.name;
+  if (!draft.description.trim()) draft.description = product.item.description;
+  if (!draft.manufacturer.trim()) draft.manufacturer = product.manufacturer;
+  if (!draft.modelNumber.trim()) draft.modelNumber = product.modelNumber;
+}
+
+export function scannerStatusAfterFrame(
+  current: ScannerStatus,
+  hasResult: boolean,
+  error?: unknown
+): ScannerStatus {
+  if (hasResult) return "detected";
+  if (error instanceof NotFoundException) return current;
+  if (error) return "error";
+  return current === "starting" ? "scanning" : current;
+}
