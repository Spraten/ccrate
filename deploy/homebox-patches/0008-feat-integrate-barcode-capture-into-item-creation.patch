 }
 
+func TestEntityRepository_CreateFromTemplate_Barcode(t *testing.T) {
+	containerET := useContainerEntityType(t)
+	cf := containerFactory()
+	cf.EntityTypeID = containerET.ID
+	container, err := tRepos.Entities.Create(context.Background(), tGroup.ID, cf)
+	require.NoError(t, err)
+
+	out, err := tRepos.Entities.CreateFromTemplate(context.Background(), tGroup.ID, EntityCreateFromTemplate{
+		Name:         "Template item with barcode",
+		Description:  "",
+		Quantity:     1,
+		ParentID:     container.ID,
+		Barcode:      " 0012345 ",
+		Manufacturer: "Eventronic",
+		ModelNumber:  "ET1001",
+	})
+	require.NoError(t, err)
+	assert.Equal(t, "0012345", out.Barcode)
+	assert.Equal(t, "Eventronic", out.Manufacturer)
+	assert.Equal(t, "ET1001", out.ModelNumber)
+
+	withoutBarcode, err := tRepos.Entities.CreateFromTemplate(context.Background(), tGroup.ID, EntityCreateFromTemplate{
+		Name:     "Template item without barcode",
+		Quantity: 1,
+		ParentID: container.ID,
+	})
+	require.NoError(t, err)
+	assert.Empty(t, withoutBarcode.Barcode)
+
+	t.Cleanup(func() {
+		_ = tRepos.Entities.Delete(context.Background(), out.ID)
+		_ = tRepos.Entities.Delete(context.Background(), withoutBarcode.ID)
+		_ = tRepos.Entities.Delete(context.Background(), container.ID)
+	})
+}
+
+func TestEntityRepository_Create_ProductDetails(t *testing.T) {
+	containerET := useContainerEntityType(t)
+	cf := containerFactory()
+	cf.EntityTypeID = containerET.ID
+	container, err := tRepos.Entities.Create(context.Background(), tGroup.ID, cf)
+	require.NoError(t, err)
+	item, err := tRepos.Entities.Create(context.Background(), tGroup.ID, EntityCreate{
+		Name:         "Product details",
+		Description:  "Catalog description",
+		Quantity:     1,
+		ParentID:     container.ID,
+		Barcode:      "0012345",
+		Manufacturer: "Eventronic",
+		ModelNumber:  "ET1001",
+	})
+	require.NoError(t, err)
+	assert.Equal(t, "0012345", item.Barcode)
+	assert.Equal(t, "Eventronic", item.Manufacturer)
+	assert.Equal(t, "ET1001", item.ModelNumber)
+
+	t.Cleanup(func() {
+		_ = tRepos.Entities.Delete(context.Background(), item.ID)
+		_ = tRepos.Entities.Delete(context.Background(), container.ID)
+	})
+}
