[Unit]
Description=Codex remote control for the equipment project
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/user/Desktop/inventory-system
Environment=PATH=/home/user/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecCondition=/home/user/.local/bin/codex login status
ExecStart=/home/user/.local/bin/codex remote-control start
ExecStop=/home/user/.local/bin/codex remote-control stop

[Install]
WantedBy=default.target
